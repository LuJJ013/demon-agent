# Copy to `.env` (never commit) or export these in your shell.

# LLM + web_search provider key. The minimal profile reads this name.
DEEPSEEK_API_KEY=

# Optional endpoint overrides.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: pin a web provider when more than one is registered.
# MH_WEB_SEARCH_PROVIDER=deepseek-official
# MH_WEB_FETCH_PROVIDER=http
