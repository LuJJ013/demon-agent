# Copy to `.env` (never commit) or export these in your shell.

# LLM key. The minimal profile reads this name.
DEEPSEEK_API_KEY=

# Primary web_search provider: Exa.
EXA_API_KEY=

# Fallback web_search provider: DeepSeek Search API (uses DEEPSEEK_API_KEY).

# Optional endpoint overrides.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# EXA_BASE_URL=https://api.exa.ai
# EXA_SEARCH_TYPE=auto            # auto | lite | deep-lite | deep
# WEB_SEARCH_TIMEOUT_MS=30000     # applies to both providers

# Optional: point the DeepSeek provider at a local stub or proxy.
# WEB_SEARCH_BASE_URL=http://127.0.0.1:8787
# WEB_SEARCH_PATH=/v1/tools/search

# Search routing. Defaults: primary exa, then deepseek-official.
# WEB_SEARCH_PRIMARY=exa
# WEB_SEARCH_FALLBACK=deepseek-official
# Set to an empty string to disable fallback entirely:
# WEB_SEARCH_FALLBACK=

# Optional: pin a fetch provider (search routing is configured above).
# MH_WEB_FETCH_PROVIDER=http
